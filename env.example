# =============================================================================
#  DAEMO AI AGENT TEMPLATE - ENVIRONMENT CONFIGURATION
# =============================================================================
#
#  Copy this file to .env and fill in your values:
#    cp env.example .env
#
# =============================================================================

# -----------------------------------------------------------------------------
#  REQUIRED: Daemo Platform Authentication
# -----------------------------------------------------------------------------

# Your Daemo Agent API Key (Get it at https://app.daemo.ai/)
DAEMO_AGENT_API_KEY=your_daemo_agent_api_key_here

# -----------------------------------------------------------------------------
#  REQUIRED: AI Model Configuration
# -----------------------------------------------------------------------------

# Choose your LLM provider: 'gemini' (default), 'anthropic', or 'openai'
LLM_PROVIDER=gemini

# Set the API key for your chosen provider (only one is needed)
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Override the default model name for your provider
# LLM_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
#  OPTIONAL: Server Configuration
# -----------------------------------------------------------------------------

# Port for the Express server (default: 5000)
PORT=5000

# Daemo Gateway URL - Use the hosted Daemo backend
DAEMO_GATEWAY_URL=https://engine.daemo.ai:50052

# -----------------------------------------------------------------------------
#  SAMPLE SERVICES: API Tokens (Recommended to avoid rate limits)
# -----------------------------------------------------------------------------

# SF 311 Data - San Francisco Open Data API
# Get a free token: https://dev.socrata.com/docs/app-tokens.html
SF_311_APP_TOKEN=your_socrata_app_token_here

# FBI Crime Data Explorer API
# Get a free key: https://api.data.gov/signup/
FBI_API_KEY=your_fbi_api_key_here
